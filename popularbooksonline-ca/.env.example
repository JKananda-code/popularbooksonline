# Copy these into Vercel → Project → Settings → Environment Variables (Production).
# Never commit the real .env — it is git-ignored.

# Public site URL (used for metadata / canonical links)
NEXT_PUBLIC_BASE_URL=https://popularbooksonline.ca

# Supabase (server-side only — service role bypasses RLS, never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Emergent universal LLM key (legacy AI ebook / cover generation — admin-only routes)
EMERGENT_LLM_KEY=

# Admin secret for /api/leads export and all write/seed/generate routes (send as X-Admin-Secret header)
# Generate with: openssl rand -hex 24
ADMIN_SECRET=

# JWT secret for legacy entitlement tokens (min 32 chars)
JWT_LICENSE_SECRET=

# Email (Gmail SMTP via Google App Password) — owner notification + reader welcome for every lead.
# Create at myaccount.google.com → Security → 2-Step Verification → App passwords. Spaces are OK.
GMAIL_USER=jkananda5@gmail.com
GMAIL_APP_PASSWORD=
OWNER_EMAIL=jkananda5@gmail.com

# Optional hardening overrides
# CORS_ORIGINS=https://popularbooksonline.ca
# FRAME_ANCESTORS='self'
# RATE_LIMIT_MAX=20

# Amazon KDP — OPTIONAL overrides. Live ASINs are built into lib/catalog.js (AMAZON_DEFAULTS).
# Only set these to override, e.g. when Book 3 launches. Empty = "Coming Soon — Notify Me".
# NEXT_PUBLIC_AMAZON_ELEPHANT_KINDLE=
# NEXT_PUBLIC_AMAZON_ELEPHANT_PAPERBACK=
